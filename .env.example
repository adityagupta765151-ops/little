# Copy this file to .env and fill in what you need. .env is never committed.

# --- The model (required for anything that needs thought)
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-flash-latest
# A lighter model for checking plan steps and summarising pages
JARVIS_MODEL_FAST=

# --- Identity and wake word
JARVIS_ASSISTANT_NAME=LITTLE
JARVIS_WAKE=
JARVIS_WAKE_MODE=auto
JARVIS_WAKE_FUZZY=0.72
# JARVIS_WAKE_SENSITIVITY=0.5

# --- Listening
JARVIS_LANG=en-IN
JARVIS_MIC=
# JARVIS_MIC_SENSITIVITY=300
JARVIS_PAUSE=1.0
JARVIS_SHOW_HEARD=true
# Seconds of follow-up without the name; 0 turns it off
JARVIS_FOLLOW_UP=6

# --- Speaking
JARVIS_VOICE=en-IN-NeerjaNeural
JARVIS_VOICE_SPEED=+5%
JARVIS_VOICE_PITCH=+10Hz
JARVIS_VOICE_VOLUME=+0%
JARVIS_VOICE_ENABLED=true
JARVIS_NEURAL_VOICE=true
# Words a minute for the local fallback voice
JARVIS_VOICE_RATE=180

# --- Files: every path is fenced inside this folder (default: JarvisWorkspace in your home)
# JARVIS_WORKSPACE=C:\Users\you\JarvisWorkspace
# Left blank these would mean "here", so they stay commented out
# JARVIS_MEMORY_DIR=
# JARVIS_LOG_FILE=

# --- Network: IPv4 is used unless this is on (broken IPv6 can stall every model call)
JARVIS_IPV6=off

# --- Browser and tools
JARVIS_BROWSER_HEADLESS=false
JARVIS_BLOCKED_TOOLS=
JARVIS_MCP_CONFIG=

# --- Proactive suggestions
JARVIS_PROACTIVE=true
JARVIS_PROACTIVE_SPEAK=false
JARVIS_QUIET_HOURS=22-8

# --- Job search
JARVIS_JOB_GEO=india
JARVIS_JOB_CITY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
MUSE_API_KEY=
